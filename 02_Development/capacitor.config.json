{
  "appId": "edu.hit.connect.prototype",
  "appName": "HIT Connect",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "showSpinner": false,
      "androidSplashResourceName": "hit_splash_logo",
      "backgroundColor": "#F8FAFC"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#A51D3D"
    }
  }
}
